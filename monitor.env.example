# GPU Monitor settings (example).
# install.sh writes monitor.env for you, so you rarely need this file.
# To configure by hand, copy it to monitor.env and edit. run-hub.sh and run-agent.sh read it.
# Restart the service after editing:  systemctl --user restart gpu-monitor-agent   (hub: gpu-monitor-hub)

# ── Both ─────────────────────────────────────────────────────────────
# Shared token between the hub and its agents. ./install.sh hub creates one.
MONITOR_TOKEN=
# Screen language: en | ko. On the hub it sets the dashboard default (viewers can switch);
# on an agent it sets the language of its messages and of the AI job descriptions.
MONITOR_LANG=en

# ── Hub ──────────────────────────────────────────────────────────────
MONITOR_PORT=8787
# Listen on one address only, e.g. a VPN address.
MONITOR_HOST=0.0.0.0

# ── Agent ────────────────────────────────────────────────────────────
# Hub address.
MONITOR_HUB=http://HUB:8787
# Name on the dashboard. Empty means hostname.
MONITOR_LABEL=
# Short note shown with this server (optional).
MONITOR_NOTE=

# AI job identification: Claude Code finds out what each GPU job is.
#   auto  on when claude is installed and logged in (default)
#   on    on; shows an error on the dashboard if claude is missing
#   off   off
MONITOR_AI=auto
# Path to claude. Empty means look in the usual install locations.
MONITOR_AI_CMD=
# subscription: the account logged in with 'claude auth login' on this server (default)
# api_key:      use ANTHROPIC_API_KEY below (billed per use)
MONITOR_AI_AUTH=subscription
# ANTHROPIC_API_KEY=

# (Optional) Run directory globs to read progress from directly, colon-separated.
# With AI identification on, logs are found automatically, so this is usually empty.
MONITOR_WATCH=
# (Optional) Disk paths to show, colon-separated. Empty means chosen automatically.
MONITOR_DISK=

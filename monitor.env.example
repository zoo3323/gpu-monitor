# GPU 모니터 설정 예시.
# 보통은 install.sh 가 monitor.env 를 만들어 주므로 손댈 일이 없다.
# 직접 쓸 때는 이 파일을 monitor.env 로 복사해 고친다. run-hub.sh·run-agent.sh 가 읽는다.
# 고친 뒤에는 서비스를 다시 띄운다:  systemctl --user restart gpu-monitor-agent

# ── 공통 ─────────────────────────────────────────────────────────────
# hub 와 에이전트가 맞춰야 하는 공유 토큰. ./install.sh hub 가 만들어 준다.
MONITOR_TOKEN=

# ── hub ──────────────────────────────────────────────────────────────
MONITOR_PORT=8787
# 특정 주소에만 열려면 그 주소를 쓴다(예: VPN 주소).
MONITOR_HOST=0.0.0.0

# ── 에이전트 ──────────────────────────────────────────────────────────
# hub 주소.
MONITOR_HUB=http://HUB:8787
# 화면에 보일 이름. 비우면 hostname.
MONITOR_LABEL=
# 화면에 함께 띄울 짧은 메모(선택).
MONITOR_NOTE=

# AI 식별: GPU 를 쓰는 작업이 무엇인지 Claude Code 가 알아낸다.
#   auto  claude 가 있고 로그인돼 있으면 켠다(기본)
#   on    켠다. claude 가 없으면 화면에 오류로 띄운다
#   off   끈다
MONITOR_AI=auto
# claude 실행 파일. 비우면 흔한 설치 위치에서 스스로 찾는다.
MONITOR_AI_CMD=
# subscription: 이 서버에서 'claude auth login' 한 계정으로 부른다(기본)
# api_key:      아래 ANTHROPIC_API_KEY 로 부른다(사용량만큼 과금)
MONITOR_AI_AUTH=subscription
# ANTHROPIC_API_KEY=

# (선택) 진행률을 직접 읽을 런 디렉터리 glob. 콜론으로 여러 개.
# AI 식별이 켜져 있으면 로그를 스스로 찾으므로 보통은 비워 둔다.
MONITOR_WATCH=
# (선택) 사용량을 볼 디스크 경로. 콜론으로 여러 개. 비우면 스스로 고른다.
MONITOR_DISK=
